# Entorno y Depuración
ENVIRONMENT=development
DEBUG=true

# Conexión PostgreSQL (Dentro de Docker usa host 'postgres', localmente usa 'localhost')
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Proveedor de Embeddings ('gemini' o 'openai')
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Proveedor de LLM ('gemini' o 'openai')
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1

# Claves de API (Configura la que vayas a usar)
GOOGLE_API_KEY=tu_google_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui

# Parámetros de Chunking Jerárquico (Parent-Child)
# Parent: contexto amplio para síntesis (~1000 tokens / 3500 chars)
PARENT_CHUNK_SIZE=3500
PARENT_CHUNK_OVERLAP=400
# Child: granularidad alta para embedding y búsqueda (~250 tokens / 800 chars)
CHILD_CHUNK_SIZE=800
CHILD_CHUNK_OVERLAP=150

# Parámetros de Recuperación Híbrida y Rerank
DENSE_TOP_K=15
SPARSE_TOP_K=15
RRF_K=60
RERANK_TOP_K=5

# Guardrails de Fuera de Dominio
GUARDRAIL_ENABLED=true
# Dominio principal esperado para validar pertinencia
SYSTEM_DOMAIN_DESCRIPTION="Documentación técnica, manuales de servicio, especificaciones y procedimientos de mantenimiento industrial o HVAC"
